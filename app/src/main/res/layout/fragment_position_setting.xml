<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        

        <TextView
            android:id="@+id/textView_position_setting"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:text="측위DB 설정"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/imageButton_position_close_setting"
            app:layout_constraintHorizontal_weight="8.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/imageButton_position_close_setting"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView_position_setting"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1.5"
            app:layout_constraintStart_toEndOf="@+id/textView_position_setting"
            app:layout_constraintTop_toTopOf="@+id/textView_position_setting"
            app:srcCompat="@drawable/ic_baseline_close_24" />


        <ScrollView
            android:id="@+id/scrollView_position_setting"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toTopOf="@+id/linearLayout_position_setting"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView_position_setting">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView_position_positioning_server_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Positioning Server"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout_position_positioning_server"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="5dp"
                    android:background="@color/white"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/textView_position_positioning_server_option_place"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/server_option_path"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView_position_positioning_server_option_ip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="@string/server_option_ip"
                        app:layout_constraintEnd_toEndOf="@+id/editText_position_positioning_server_option_ip"
                        app:layout_constraintHorizontal_weight="5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView_position_positioning_server_option_place" />

                    <TextView
                        android:id="@+id/textView_position_positioning_server_option_port"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="@string/server_option_port"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="3"
                        app:layout_constraintStart_toEndOf="@+id/textView_position_positioning_server_option_colon"
                        app:layout_constraintTop_toBottomOf="@+id/textView_position_positioning_server_option_place" />

                    <EditText
                        android:id="@+id/editText_position_positioning_server_option_ip"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginTop="5dp"
                        android:ems="10"
                        android:gravity="center"
                        android:hint="http://example.com"
                        android:inputType="textUri"
                        app:layout_constraintEnd_toStartOf="@+id/textView_position_positioning_server_option_colon"
                        app:layout_constraintHorizontal_weight="5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView_position_positioning_server_option_ip" />

                    <TextView
                        android:id="@+id/textView_position_positioning_server_option_colon"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:gravity="center"
                        android:text="@string/colon"
                        app:layout_constraintBottom_toBottomOf="@+id/editText_position_positioning_server_option_ip"
                        app:layout_constraintEnd_toStartOf="@+id/editText_position_positioning_server_option_port"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/editText_position_positioning_server_option_ip"
                        app:layout_constraintTop_toTopOf="@+id/editText_position_positioning_server_option_ip" />

                    <EditText
                        android:id="@+id/editText_position_positioning_server_option_port"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="5dp"
                        android:ems="10"
                        android:gravity="center"
                        android:hint="8080"
                        android:inputType="number"
                        app:layout_constraintBottom_toBottomOf="@+id/textView_position_positioning_server_option_colon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="4"
                        app:layout_constraintStart_toEndOf="@+id/textView_position_positioning_server_option_colon"
                        app:layout_constraintTop_toBottomOf="@+id/textView_position_positioning_server_option_port" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </ScrollView>


        <LinearLayout
            android:id="@+id/linearLayout_position_setting"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/imageButton_position_save_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_baseline_save_48" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>